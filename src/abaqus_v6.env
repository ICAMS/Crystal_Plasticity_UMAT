# Extend Abaqus's existing Fortran compiler command.
import shlex

if isinstance(compile_fortran, str):
    compile_fortran = shlex.split(compile_fortran)
else:
    compile_fortran = list(compile_fortran)

if isinstance(link_sl, str):
    link_sl = shlex.split(link_sl)
else:
    link_sl = list(link_sl)

if '-qopenmp' not in compile_fortran:
    compile_fortran.append('-qopenmp')

if '-qopenmp' not in link_sl:
    link_sl.append('-qopenmp')

